# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection used by migrations and scripts.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Shared password for the web app and the mobile app.
# Leave empty to disable login entirely (the app becomes publicly readable).
APP_PASSWORD=""

# Signs session tokens. Use a long random value; changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
