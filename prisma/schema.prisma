generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProductType {
  PURCHASED
  MANUFACTURED
}

enum UnitOfMeasure {
  PIECES
  PACKETS
  KILOGRAMS
  GRAMS
  BOXES
  BOTTLES
  LITERS
  MILLILITERS
}

enum CustomerType {
  RETAIL
  SHOP
  WHOLESALE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PurchaseItemType {
  FINISHED_PRODUCT
  RAW_MATERIAL
  PACKAGING
}

enum InventoryItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_PRODUCT
}

enum StockMovementType {
  PURCHASE
  PRODUCTION_IN
  PRODUCTION_OUT
  PACKAGING_IN
  PACKAGING_OUT
  SALE
  WHOLESALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum ExpenseCategory {
  TRANSPORT
  DELIVERY
  ADVERTISING
  ELECTRICITY
  RENT
  LABOUR
  EQUIPMENT
  FACEBOOK_ADS
  INSTAGRAM_ADS
  WHATSAPP_PROMO
  PRINTING
  MARKETING
  MISCELLANEOUS
}

enum PaymentEntityType {
  SUPPLIER
  CUSTOMER
}

enum ProductLotSourceType {
  PURCHASE
  PRODUCTION
  PACKAGING
}

// ─── Settings ────────────────────────────────────────────────────────────────

model AppSettings {
  id                    String  @id @default(cuid())
  allowNegativeInventory Boolean @default(false)
  companyName           String  @default("Sweet Fusion")
  currency              String  @default("LKR")
  currencySymbol        String  @default("Rs.")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─── Master Data ───────────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String          @id @default(cuid())
  name            String
  sku             String          @unique
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  imageUrl        String?
  type            ProductType
  unit            UnitOfMeasure
  sellingPrice    Decimal         @default(0) @db.Decimal(12, 2)
  wholesalePrice  Decimal         @default(0) @db.Decimal(12, 2)
  minStockLevel   Decimal         @default(0) @db.Decimal(12, 3)
  currentStock    Decimal         @default(0) @db.Decimal(12, 3)
  averageCost     Decimal         @default(0) @db.Decimal(12, 2)
  description     String?
  isActive        Boolean         @default(true)
  recipes         Recipe[]
  productionBatches ProductionBatch[]
  purchaseItems   PurchaseItem[]
  productLots     ProductLot[]
  packagingOps    PackagingOperation[]
  salesOrderItems SalesOrderItem[]
  wholesaleItems  WholesaleSupplyItem[]
  expenses        Expense[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([type])
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  whatsapp      String?
  address       String?
  notes         String?
  purchases     Purchase[]
  payments      Payment[] @relation("SupplierPayments")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  phone            String?
  whatsapp         String?
  address          String?
  type             CustomerType      @default(RETAIL)
  notes            String?
  salesOrders      SalesOrder[]
  wholesaleSupplies WholesaleSupply[]
  payments         Payment[]         @relation("CustomerPayments")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model RawMaterial {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  category                String?
  unit                    UnitOfMeasure
  currentStock            Decimal                   @default(0) @db.Decimal(12, 3)
  minStockLevel           Decimal                   @default(0) @db.Decimal(12, 3)
  averageCost             Decimal                   @default(0) @db.Decimal(12, 2)
  description             String?
  purchaseItems           PurchaseItem[]
  recipeIngredients       RecipeIngredient[]
  productionBatchIngredients ProductionBatchIngredient[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model PackagingMaterial {
  id                      String                    @id @default(cuid())
  name                    String                    @unique
  unit                    UnitOfMeasure             @default(PIECES)
  currentStock            Decimal                   @default(0) @db.Decimal(12, 3)
  minStockLevel           Decimal                   @default(0) @db.Decimal(12, 3)
  averageCost             Decimal                   @default(0) @db.Decimal(12, 2)
  description             String?
  purchaseItems           PurchaseItem[]
  packagingOpMaterials    PackagingOperationMaterial[]
  salesOrderItemPackaging SalesOrderItemPackaging[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

// ─── Recipes ───────────────────────────────────────────────────────────────────

model Recipe {
  id                    String             @id @default(cuid())
  name                  String
  productId             String
  product               Product            @relation(fields: [productId], references: [id])
  expectedOutputQty     Decimal            @db.Decimal(12, 3)
  outputUnit            UnitOfMeasure
  notes                 String?
  ingredients           RecipeIngredient[]
  productionBatches     ProductionBatch[]
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([productId])
}

model RecipeIngredient {
  id            String      @id @default(cuid())
  recipeId      String
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal     @db.Decimal(12, 3)
  unit          UnitOfMeasure

  @@unique([recipeId, rawMaterialId])
}

// ─── Purchases ─────────────────────────────────────────────────────────────────

model Purchase {
  id            String        @id @default(cuid())
  purchaseNumber String       @unique
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchaseDate  DateTime      @default(now())
  invoiceRef    String?
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  items         PurchaseItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id                  String            @id @default(cuid())
  purchaseId          String
  purchase            Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemType            PurchaseItemType
  productId           String?
  product             Product?          @relation(fields: [productId], references: [id])
  rawMaterialId       String?
  rawMaterial         RawMaterial?      @relation(fields: [rawMaterialId], references: [id])
  packagingMaterialId String?
  packagingMaterial   PackagingMaterial? @relation(fields: [packagingMaterialId], references: [id])
  quantity            Decimal           @db.Decimal(12, 3)
  unit                UnitOfMeasure
  unitCost            Decimal           @db.Decimal(12, 2)
  totalCost           Decimal           @db.Decimal(12, 2)
  productLots         ProductLot[]

  @@index([purchaseId])
}

// ─── Production ────────────────────────────────────────────────────────────────

model ProductionBatch {
  id              String                      @id @default(cuid())
  batchNumber     String                      @unique
  productId       String
  product         Product                     @relation(fields: [productId], references: [id])
  recipeId        String?
  recipe          Recipe?                     @relation(fields: [recipeId], references: [id])
  productionDate  DateTime                    @default(now())
  outputQuantity  Decimal                     @db.Decimal(12, 3)
  outputUnit      UnitOfMeasure
  labourCost      Decimal                     @default(0) @db.Decimal(12, 2)
  otherCost       Decimal                     @default(0) @db.Decimal(12, 2)
  ingredientCost  Decimal                     @default(0) @db.Decimal(12, 2)
  totalCost       Decimal                     @default(0) @db.Decimal(12, 2)
  costPerUnit     Decimal                     @default(0) @db.Decimal(12, 2)
  notes           String?
  ingredients     ProductionBatchIngredient[]
  productLots     ProductLot[]
  expenses        Expense[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([productId])
  @@index([productionDate])
}

model ProductionBatchIngredient {
  id                String          @id @default(cuid())
  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  quantityUsed      Decimal         @db.Decimal(12, 3)
  unit              UnitOfMeasure
  unitCost          Decimal         @db.Decimal(12, 2)
  totalCost         Decimal         @db.Decimal(12, 2)

  @@index([productionBatchId])
}

// ─── Packaging ─────────────────────────────────────────────────────────────────

model PackagingOperation {
  id                  String                       @id @default(cuid())
  operationNumber     String                       @unique
  productId           String
  product             Product                      @relation(fields: [productId], references: [id])
  sourceLotId         String?
  sourceLot           ProductLot?                  @relation("SourceLot", fields: [sourceLotId], references: [id])
  quantity            Decimal                      @db.Decimal(12, 3)
  unit                UnitOfMeasure
  sourceUnitCost      Decimal                      @default(0) @db.Decimal(12, 2)
  totalPackagingCost  Decimal                      @default(0) @db.Decimal(12, 2)
  totalCost           Decimal                      @default(0) @db.Decimal(12, 2)
  costPerUnit         Decimal                      @default(0) @db.Decimal(12, 2)
  operationDate       DateTime                     @default(now())
  notes               String?
  materials           PackagingOperationMaterial[]
  outputLots          ProductLot[]                 @relation("PackagingOutput")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([productId])
}

model PackagingOperationMaterial {
  id                   String              @id @default(cuid())
  packagingOperationId String
  packagingOperation   PackagingOperation  @relation(fields: [packagingOperationId], references: [id], onDelete: Cascade)
  packagingMaterialId  String
  packagingMaterial    PackagingMaterial   @relation(fields: [packagingMaterialId], references: [id])
  quantityUsed         Decimal             @db.Decimal(12, 3)
  unit                 UnitOfMeasure
  unitCost             Decimal             @db.Decimal(12, 2)
  totalCost            Decimal             @db.Decimal(12, 2)

  @@index([packagingOperationId])
}

// ─── Inventory Lots & Movements ────────────────────────────────────────────────

model ProductLot {
  id                   String               @id @default(cuid())
  lotNumber            String               @unique
  productId            String
  product              Product              @relation(fields: [productId], references: [id])
  sourceType           ProductLotSourceType
  purchaseItemId       String?
  purchaseItem         PurchaseItem?        @relation(fields: [purchaseItemId], references: [id])
  productionBatchId    String?
  productionBatch      ProductionBatch?     @relation(fields: [productionBatchId], references: [id])
  packagingOperationId String?
  packagingOperation   PackagingOperation?  @relation("PackagingOutput", fields: [packagingOperationId], references: [id])
  initialQuantity      Decimal              @db.Decimal(12, 3)
  remainingQuantity    Decimal              @db.Decimal(12, 3)
  unit                 UnitOfMeasure
  purchaseCost         Decimal              @default(0) @db.Decimal(12, 2)
  productionCost       Decimal              @default(0) @db.Decimal(12, 2)
  packagingCost        Decimal              @default(0) @db.Decimal(12, 2)
  unitCost             Decimal              @default(0) @db.Decimal(12, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sourceForPackaging   PackagingOperation[] @relation("SourceLot")
  salesOrderItems      SalesOrderItem[]
  wholesaleItems       WholesaleSupplyItem[]

  @@index([productId])
}

model InventoryMovement {
  id            String            @id @default(cuid())
  itemType      InventoryItemType
  itemId        String
  itemName      String
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  unit          UnitOfMeasure
  unitCost      Decimal           @default(0) @db.Decimal(12, 2)
  totalCost     Decimal           @default(0) @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  notes         String?
  movementDate  DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([itemType, itemId])
  @@index([movementDate])
  @@index([referenceType, referenceId])
}

// ─── Sales & Wholesale ─────────────────────────────────────────────────────────

model SalesOrder {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  orderDate     DateTime       @default(now())
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus  @default(UNPAID)
  notes         String?
  items         SalesOrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([customerId])
  @@index([orderDate])
}

model SalesOrderItem {
  id           String      @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  productLotId String?
  productLot   ProductLot? @relation(fields: [productLotId], references: [id])
  quantity     Decimal     @db.Decimal(12, 3)
  unit         UnitOfMeasure
  unitPrice     Decimal     @db.Decimal(12, 2)
  unitCost      Decimal     @default(0) @db.Decimal(12, 2)
  packagingCost Decimal     @default(0) @db.Decimal(12, 2)
  totalPrice    Decimal     @db.Decimal(12, 2)
  totalCost     Decimal     @default(0) @db.Decimal(12, 2)
  packaging     SalesOrderItemPackaging[]

  @@index([salesOrderId])
}

model SalesOrderItemPackaging {
  id                  String            @id @default(cuid())
  salesOrderItemId    String
  salesOrderItem      SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  packagingMaterialId String
  packagingMaterial   PackagingMaterial @relation(fields: [packagingMaterialId], references: [id])
  quantityUsed        Decimal           @db.Decimal(12, 3)
  unit                UnitOfMeasure
  unitCost            Decimal           @db.Decimal(12, 2)
  totalCost           Decimal           @db.Decimal(12, 2)

  @@index([salesOrderItemId])
}

model WholesaleSupply {
  id            String                @id @default(cuid())
  supplyNumber  String                @unique
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id])
  supplyDate    DateTime              @default(now())
  dueDate       DateTime?
  subtotal      Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus         @default(UNPAID)
  notes         String?
  items         WholesaleSupplyItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([customerId])
  @@index([supplyDate])
}

model WholesaleSupplyItem {
  id                String          @id @default(cuid())
  wholesaleSupplyId String
  wholesaleSupply   WholesaleSupply @relation(fields: [wholesaleSupplyId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  productLotId      String?
  productLot        ProductLot?     @relation(fields: [productLotId], references: [id])
  quantity          Decimal         @db.Decimal(12, 3)
  unit              UnitOfMeasure
  unitPrice         Decimal         @db.Decimal(12, 2)
  unitCost          Decimal         @default(0) @db.Decimal(12, 2)
  totalPrice        Decimal         @db.Decimal(12, 2)
  totalCost         Decimal         @default(0) @db.Decimal(12, 2)

  @@index([wholesaleSupplyId])
}

// ─── Payments & Expenses ───────────────────────────────────────────────────────

model Payment {
  id          String            @id @default(cuid())
  paymentNumber String          @unique
  entityType  PaymentEntityType
  supplierId  String?
  supplier    Supplier?         @relation("SupplierPayments", fields: [supplierId], references: [id])
  customerId  String?
  customer    Customer?         @relation("CustomerPayments", fields: [customerId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  paymentDate DateTime          @default(now())
  referenceType String?
  referenceId   String?
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([supplierId])
  @@index([customerId])
  @@index([paymentDate])
}

model Expense {
  id                String          @id @default(cuid())
  expenseDate       DateTime        @default(now())
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(12, 2)
  description       String
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  includeInProductionCost Boolean   @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([expenseDate])
  @@index([category])
}
